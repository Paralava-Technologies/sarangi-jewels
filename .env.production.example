# ─── Sarangi Jewels — Production Environment Variables ────────────────────────────────
#
# Copy this file to .env.production on your production server.
# NEVER commit the real .env.production to version control.
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=noeve
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=noeve

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT (use a minimum 64-char random string) ─────────────────────────────────
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=noeve
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_SECRET
S3_BUCKET=noeve-media
S3_REGION=ap-south-1

# ── Razorpay (leave blank to use mock/sandbox mode) ──────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Web Store public API URL (baked into Next.js build) ──────────────────────
NEXT_PUBLIC_API_URL=https://api.sarangijewels.com/v1
