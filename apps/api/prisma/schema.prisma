generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  FULFILLMENT
  SUPPORT
}

enum UserTier {
  RETAIL
  WHOLESALE
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  PICKED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RMAStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum CODSettlementStatus {
  PENDING_COLLECTION
  COLLECTED_BY_PARTNER
  SETTLED_TO_BANK
  DISCREPANCY
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  role         UserRole @default(CUSTOMER)
  tier         UserTier @default(RETAIL)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  idVerificationStatus String?  @map("id_verification_status")
  idDocumentUrl        String?  @map("id_document_url")

  orders         Order[]
  cart           Cart?
  wishlist       WishlistItem[]
  reviews        Review[]
  addresses      Address[]
  supportTickets SupportTicket[]
  comments       Comment[]
  makeupSessions MakeupSession[]

  @@map("users")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("newsletter_subscribers")
}

model Address {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  phone       String
  streetLine1 String   @map("street_line_1")
  streetLine2 String?  @map("street_line_2")
  city        String
  state       String
  postalCode  String   @map("postal_code")
  country     String   @default("IN")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Category {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  description       String?
  imageUrl          String?  @map("image_url")
  sortOrder         Int      @default(0) @map("sort_order")
  taxRatePercentage Float?   @map("tax_rate_percentage")
  returnPolicy      String?  @map("return_policy")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([slug])
  @@map("categories")
}

model Product {
  id                 String        @id @default(uuid())
  name               String
  slug               String        @unique
  description        String?
  status             ProductStatus @default(DRAFT)
  categoryId         String        @map("category_id")
  basePriceCents     Int           @map("base_price_cents")
  rentPriceCents     Int?          @map("rent_price_cents")
  currency           String        @default("INR")
  hsnCode            String?       @map("hsn_code")
  material           String?
  purity             String?
  gemstone           String?
  weightGrams        Float?        @map("weight_grams")
  composition        String?
  sizeAndFit         String?       @map("size_and_fit")
  shippingAndReturns String?       @map("shipping_and_returns")
  careInstructions   String?       @map("care_instructions")
  certificateUrl     String?       @map("certificate_url")
  viewCount          Int           @default(0) @map("view_count")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  category      Category         @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  variants      ProductVariant[]
  cartLines     CartLine[]
  wishlistItems WishlistItem[]
  reviews       Review[]

  @@index([categoryId])
  @@index([slug])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  url       String
  alt       String?
  sortOrder Int     @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id            String  @id @default(uuid())
  productId     String  @map("product_id")
  sku           String  @unique
  name          String
  priceCents    Int     @map("price_cents")
  rentPriceCents Int?   @map("rent_price_cents")
  stockQuantity Int     @default(0) @map("stock_quantity")
  isDigital     Boolean @default(false) @map("is_digital")

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartLines       CartLine[]
  tieredPrices    TieredPrice[]
  inventoryLevels InventoryLevel[]
  serialNumbers   SerialNumber[]
  kitParent       KitComponent[]   @relation("KitParent")
  kitChild        KitComponent[]   @relation("KitChild")

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id")
  sessionId String?  @unique @map("session_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines CartLine[]

  @@map("carts")
}

model CartLine {
  id        String  @id @default(uuid())
  cartId    String  @map("cart_id")
  productId String  @map("product_id")
  variantId      String?   @map("variant_id")
  quantity       Int       @default(1)
  isRental       Boolean   @default(false) @map("is_rental")
  rentStartDate  DateTime? @map("rent_start_date")
  rentEndDate    DateTime? @map("rent_end_date")

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("cart_lines")
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique @map("order_number")
  userId         String      @map("user_id")
  status         OrderStatus @default(PENDING_PAYMENT)
  subtotalCents  Int         @map("subtotal_cents")
  shippingCents  Int         @default(0) @map("shipping_cents")
  taxCents       Int         @default(0) @map("tax_cents")
  discountCents  Int         @default(0) @map("discount_cents")
  totalCents     Int         @map("total_cents")
  currency       String      @default("INR")
  promotionCode  String?     @map("promotion_code")
  trackingNumber String?     @map("tracking_number")
  carrier        String?
  isPickup       Boolean     @default(false) @map("is_pickup")
  deliveryDate   DateTime?   @map("delivery_date")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user          User                 @relation(fields: [userId], references: [id])
  lines         OrderLine[]
  statusHistory OrderStatusHistory[]
  payment       Payment?
  shipment      Shipment?
  rmas          RMA[]
  serialNumbers SerialNumber[]
  codSettlement CODSettlement?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderLine {
  id             String  @id @default(uuid())
  orderId        String  @map("order_id")
  productId      String  @map("product_id")
  variantId      String? @map("variant_id")
  productName    String  @map("product_name")
  sku            String
  quantity       Int
  unitPriceCents Int     @map("unit_price_cents")
  lineTotalCents Int     @map("line_total_cents")
  cgstCents      Int       @default(0) @map("cgst_cents")
  sgstCents      Int       @default(0) @map("sgst_cents")
  igstCents      Int       @default(0) @map("igst_cents")
  isRental       Boolean   @default(false) @map("is_rental")
  rentStartDate  DateTime? @map("rent_start_date")
  rentEndDate    DateTime? @map("rent_end_date")

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rmaLines RMALine[]

  @@index([orderId])
  @@index([productId])
  @@map("order_lines")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  note      String?
  createdBy String?     @map("created_by")
  createdAt DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique @map("order_id")
  amountCents       Int           @map("amount_cents")
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  provider          String        @default("RAZORPAY")
  providerOrderId   String?       @map("provider_order_id")
  providerPaymentId String?       @map("provider_payment_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Promotion {
  id                 String    @id @default(uuid())
  code               String    @unique
  description        String?
  discountPercentage Int?      @map("discount_percentage")
  discountCents      Int?      @map("discount_cents")
  minOrderValue      Int       @default(0) @map("min_order_value")
  rules              Json?     @map("rules")
  isActive           Boolean   @default(true) @map("is_active")
  expiresAt          DateTime? @map("expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("promotions")
}

model StoreSettings {
  id                     String   @id @default(uuid())
  storeName              String   @default("Sarangi Jewels Store") @map("store_name")
  supportEmail           String?  @map("support_email")
  supportPhone           String?  @map("support_phone")
  whatsappNumber         String?  @map("whatsapp_number")
  facebookLink           String?  @map("facebook_link")
  instagramLink          String?  @map("instagram_link")
  codAllowed             Boolean  @default(false) @map("cod_allowed")
  codReconciliationMode  String   @default("MANUAL") @map("cod_reconciliation_mode")
  shippingThresholdCents Int      @default(1500000) @map("shipping_threshold_cents")
  shippingRateCents      Int      @default(100000) @map("shipping_rate_cents") // Default Delivery Charge
  taxRatePercentage      Float    @default(0) @map("tax_rate_percentage")
  storeState             String   @default("Kerala") @map("store_state")
  gstin                  String?
  marqueeText            String?  @map("marquee_text")
  rentalDeliveryAllowed  Boolean  @default(true) @map("rental_delivery_allowed")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model Review {
  id        String       @id @default(uuid())
  productId String       @map("product_id")
  userId    String       @map("user_id")
  rating    Int
  comment   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  replies SupportTicketReply[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportTicketReply {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  message   String
  isAdmin   Boolean  @default(false) @map("is_admin")
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_ticket_replies")
}

model Shipment {
  id             String    @id @default(uuid())
  orderId        String    @unique @map("order_id")
  trackingNumber String?   @map("tracking_number")
  carrier        String?
  labelUrl       String?   @map("label_url")
  dispatchedAt   DateTime? @map("dispatched_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

model BlogCategory {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_categories")
}

model Post {
  id             String        @id @default(uuid())
  title          String
  slug           String        @unique
  excerpt        String?
  content        String        @db.Text
  published      Boolean       @default(false)
  author         String
  imageUrl       String?
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  tags           String[]
  categoryId     String?
  category       BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments       Comment[]
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("posts")
}

model RMA {
  id        String    @id @default(uuid())
  orderId   String    @map("order_id")
  status    RMAStatus @default(REQUESTED)
  reason    String
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  order Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines RMALine[]

  @@map("rmas")
}

model RMALine {
  id          String @id @default(uuid())
  rmaId       String @map("rma_id")
  orderLineId String @map("order_line_id")
  quantity    Int

  rma       RMA       @relation(fields: [rmaId], references: [id], onDelete: Cascade)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@map("rma_lines")
}

model TieredPrice {
  id         String   @id @default(uuid())
  variantId  String   @map("variant_id")
  tier       UserTier
  priceCents Int      @map("price_cents")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, tier])
  @@map("tiered_prices")
}

model Location {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("WAREHOUSE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inventory InventoryLevel[]

  @@map("locations")
}

model InventoryLevel {
  variantId     String @map("variant_id")
  locationId    String @map("location_id")
  stockQuantity Int    @default(0) @map("stock_quantity")

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([variantId, locationId])
  @@map("inventory_levels")
}

model SerialNumber {
  id        String  @id @default(uuid())
  variantId String  @map("variant_id")
  serial    String  @unique
  status    String  @default("IN_STOCK")
  orderId   String? @map("order_id")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("serial_numbers")
}

model KitComponent {
  id              String @id @default(uuid())
  parentVariantId String @map("parent_variant_id")
  childVariantId  String @map("child_variant_id")
  quantity        Int    @default(1)

  parentVariant ProductVariant @relation("KitParent", fields: [parentVariantId], references: [id], onDelete: Cascade)
  childVariant  ProductVariant @relation("KitChild", fields: [childVariantId], references: [id], onDelete: Cascade)

  @@map("kit_components")
}

model CODSettlement {
  id                  String              @id @default(uuid())
  orderId             String              @unique @map("order_id")
  status              CODSettlementStatus @default(PENDING_COLLECTION)
  settledAmountCents  Int?                @map("settled_amount_cents")
  expectedAmountCents Int                 @map("expected_amount_cents")
  settlementReference String?             @map("settlement_reference")
  settledAt           DateTime?           @map("settled_at")
  partnerName         String?             @map("partner_name")
  discrepancyReason   String?             @map("discrepancy_reason")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("cod_settlements")
}

model Comment {
  id        String       @id @default(uuid())
  content   String       @db.Text
  postId    String       @map("post_id")
  userId    String       @map("user_id")
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@map("comments")
}

model TaxRule {
  id              String   @id @default(uuid())
  hsnCode         String   @unique @map("hsn_code")
  description     String?
  cgstPercentage  Float    @default(0) @map("cgst_percentage")
  sgstPercentage  Float    @default(0) @map("sgst_percentage")
  igstPercentage  Float    @default(0) @map("igst_percentage")
  cessPercentage  Float    @default(0) @map("cess_percentage")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("tax_rules")
}

model MakeupSession {
  id           String        @id @default(uuid())
  userId       String?       @map("user_id")
  serviceName  String        @map("service_name")
  location     String
  date         DateTime
  time         String
  address      String?
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("makeup_sessions")
}

model MakeupPackage {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  priceCents  Int      @map("price_cents")
  currency    String   @default("INR")
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("makeup_packages")
}
